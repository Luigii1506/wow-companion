filters:
  and:
    - file.inFolder("03-Professions")
    - file.ext == "md"
    - type != "moc"
views:
  - type: table
    name: Profesiones
    order:
      - file.name
      - type
      - status
      - confidence
      - last_verified
    sort:
      - property: file.name
        direction: ASC
